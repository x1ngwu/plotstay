{
  "name": "plotstay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/preview.mjs",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace @plotstay/web",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "check": "tsc --noEmit && npm run check --workspace @plotstay/web",
    "build": "npm run check && node scripts/build.mjs",
    "start:api": "node --env-file=.env apps/api/dist/server.mjs",
    "start:web": "node --env-file=.env apps/web/server.mjs",
    "start:worker": "node --env-file=.env apps/worker/dist/main.mjs",
    "test": "tsx --test --test-concurrency=1 tests/foundation.test.ts tests/management.test.ts tests/translation.test.ts tests/seo-migration.test.ts tests/discovery.test.ts tests/details.test.ts tests/stay-repair.test.ts tests/experience-repair.test.ts tests/service-repair.test.ts tests/booking.test.ts tests/content-management.test.ts tests/persona-reviews.test.ts",
    "test:e2e": "npm run build && tsx --test --test-concurrency=1 tests/ssr.test.ts tests/seo.test.ts tests/dev.test.ts tests/discovery-e2e.test.ts tests/details-e2e.test.ts tests/booking-e2e.test.ts tests/content-management-e2e.test.ts tests/persona-reviews-e2e.test.ts",
    "db:seed:discovery": "tsx scripts/seed-discovery.ts",
    "db:seed:stay-details": "tsx scripts/seed-stay-details.ts",
    "db:seed:experience-details": "tsx scripts/seed-experience-details.ts",
    "db:seed:experience-reviews": "tsx scripts/seed-experience-reviews.ts",
    "db:seed:service-details": "tsx scripts/seed-service-details.ts",
    "db:init:details": "tsx scripts/initialize-detail-settings.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
