---
interface Props { id: string; title: string; languageTag?: string }
const { id, title, languageTag } = Astro.props;
---
<section class="detail-section content-section" id={id} aria-labelledby={`${id}-heading`}>
  <div class="section-heading"><h2 id={`${id}-heading`}>{title}</h2></div>
  <div class="detail-section-body" lang={languageTag}><slot /></div>
</section>
