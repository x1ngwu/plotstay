---
import { detailMessages, detailBilingual, contentFallback } from '../../../lib/detail-copy';
import type { Locale, PublicContent } from '@plotstay/contracts';
import Expand from './Expand.astro';
const { review, locale, nonStay = false, preview = false } = Astro.props as { review: PublicContent; locale: Locale; nonStay?: boolean; preview?: boolean };
const t = detailBilingual(locale.code, Astro.locals.detailCopy, 'common');
const ui = detailMessages(locale.code, Astro.locals.detailCopy);
const profile = review.text.review;
const name = contentFallback(review,'review.name',profile?.name,review.signature?.name || review.personaName || t('旅客姓名待补充','Visitor name to be added'));
const paragraphs = review.text.description.split('\n\n');
const excerpt = paragraphs[0]!.slice(0,210);
const remainder = review.text.description.slice(excerpt.length);
---
<article class="stay-review" lang={review.languageTag} data-note-id={review.id} data-review-preview={preview ? '' : undefined}>
  <header>{review.signature?.avatarImage && <img class="stay-avatar stay-review-avatar" src={review.signature.avatarImage} alt=""/>}<span hidden={!!review.signature?.avatarImage} class="stay-avatar stay-review-avatar" aria-hidden="true">{Array.from(name).slice(0,2).join('')}</span><div><h3>{name}</h3><p>{contentFallback(review,'review.origin',profile?.origin,t('来自：待补充','From: to be added'))}</p></div></header>
  <p class="stay-review-meta"><span class="stay-stars" aria-label={review.attributes.rating ? t.format('stars',{count:review.attributes.rating},review.attributes.rating) : t('暂无评分','Not rated')}>{review.attributes.rating ? '★'.repeat(review.attributes.rating) + '☆'.repeat(5-review.attributes.rating) : '—'}</span><time datetime={review.publishedAt}>{new Intl.DateTimeFormat(locale.languageTag,{year:'numeric',month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(review.publishedAt))}</time><span>{contentFallback(review,'review.stayDuration',profile?.stayDuration,(nonStay ? t('参与场次待补充','Session details to be added') : t('住宿时长待补充','Stay duration to be added')))}</span></p>
  <p class="stay-review-title">{review.text.title}</p><p class="prose stay-review-preview">{excerpt}{remainder && '…'}</p>
  <Expand locale={locale} label={t('查看完整手记','Show more')}><p class="prose">{review.text.description}</p></Expand>
  {review.reply && <section class="provider-reply"><h4>{locale.code==='zh-CN'?'提供者回复':'Provider reply'} · {review.reply.name}</h4>{review.reply.avatarImage&&<img class="stay-avatar" src={review.reply.avatarImage} alt=""/>}<p class="prose">{review.reply.body}</p><time datetime={review.reply.publishedAt}>{new Intl.DateTimeFormat(locale.languageTag,{dateStyle:'medium',timeZone:'UTC'}).format(new Date(review.reply.publishedAt))}</time>{review.reply.isFallback&&<p class="notice">{ui.fallback}</p>}</section>}
  {!preview && <a data-provider-reply={review.id} hidden href={`/${locale.pathPrefix}/account?reply=${review.id}`}>{locale.code==='zh-CN'?'以提供者角色回复':'Reply as provider'}</a>}
  {review.isFallback && <p class="notice">{ui.fallback}</p>}
</article>
<style>.provider-reply{margin:1rem 0 0 1rem;border-left:3px solid currentColor;padding:.75rem}.provider-reply .stay-avatar{width:32px;height:32px}</style>
