---
import { detailMessages, detailBilingual, contentFallback } from '../../../lib/detail-copy';
import { reviewRatingKeys, type ContentDetail, type Locale } from '@plotstay/contracts';
import DetailSection from '../DetailSection.astro';
import ReviewCard from './ReviewCard.astro';
import Icon from './Icon.astro';
const { detail, locale, pageHref } = Astro.props as { detail: ContentDetail; locale: Locale; pageHref: (page: number) => string };
const { reviews, reviewSummary: stats } = detail, t = detailBilingual(locale.code, Astro.locals.detailCopy, 'common'), ui = detailMessages(locale.code,Astro.locals.detailCopy);
const experience = detail.content.kind === 'experience';
const service = detail.content.kind === 'service';
const nonStay = experience || service;
const ratingKeys = nonStay ? (['accuracy','communication','value'] as const) : reviewRatingKeys;
const dimensions={cleanliness:{label:t('清洁度','Cleanliness'),icon:'light'},accuracy:{label:t('描述准确度','Accuracy'),icon:'book'},checkIn:{label:t('入住体验','Check-in'),icon:'key'},communication:{label:t('沟通','Communication'),icon:'person'},location:{label:t('位置','Location'),icon:'transit'},value:{label:t('性价比','Value'),icon:'star'}};
---
<div data-stay-module={nonStay ? undefined : "07"} data-service-reviews={service ? "" : undefined} data-experience-reviews={experience ? "" : undefined}><DetailSection id="notes" title={`${ui.notes} · ${reviews.total}`}>
  {!detail.content.preview && <p><a data-write-review href={`/${locale.pathPrefix}/account?target=${detail.content.id}`}>{locale.code==='zh-CN'?'以角色写评价':'Write in character'}</a></p>}
  <div class="stay-review-heading">
    <div class="stay-rating-large"><Icon/><strong>{stats.rating?.toFixed(2) ?? '—'}</strong><Icon/></div>
    <h3 lang={detail.content.languageTag}>{contentFallback(detail.content,'stay.favoriteTitle',detail.content.text.stay?.favoriteTitle,t('旅客口碑','Guest impressions'))}</h3>
    <p>{stats.ratedCount ? t.format('rated',{count:stats.ratedCount},stats.ratedCount) : t('暂无评分，期待第一篇手记。','No ratings yet. The first visitor note is still to come.')}</p>
  </div>
  <div class="stay-rating-breakdown">
    <div class="stay-rating-distribution"><h3>{t('总体评分','Overall rating')}</h3>{[5,4,3,2,1].map(rating=>{const count=stats.distribution.find(d=>d.rating===rating)?.count ?? 0;return <div><span>{rating}</span><meter min="0" max={Math.max(stats.ratedCount,1)} value={count} aria-label={t.format('distribution',{rating,count},count)}/><span>{count}</span></div>;})}</div>
    {ratingKeys.map(key=><div class="stay-rating-dimension"><h3>{dimensions[key].label}</h3><strong>{stats.dimensions[key]?.rating.toFixed(1) ?? '—'}</strong><Icon name={dimensions[key].icon}/><small>{t.format('ratingCount',{count:stats.dimensions[key]?.count??0},stats.dimensions[key]?.count)}</small></div>)}
  </div>
  <div class="stay-mentions"><h3>{t('旅客提到','Guests mention')}</h3>
    {stats.mentions.length ? <ul>{stats.mentions.map(topic => <li><span>{topic.label}</span><strong>{topic.count}</strong></li>)}</ul> : <p class="stay-placeholder">{t('关键词与提及次数将在手记发布后显示。','Topics and mention counts will appear when visitor notes are published.')}</p>}
  </div>
  <div class="stay-review-grid">{reviews.contents.map(review => <ReviewCard review={review} locale={locale} nonStay={nonStay} preview={!!detail.content.preview}/>)}</div>
  {!reviews.total && <article class="stay-review stay-review-empty"><header><span class="stay-avatar"><Icon name="person"/></span><div><h3>{t('第一位旅客的手记','The first visitor’s note')}</h3><p>{(nonStay ? t('人物、所在地、评分、日期与参与场次待补充。','Visitor, origin, rating, date and session details to be added.') : t('人物、所在地、评分、日期与住宿时长待补充。','Visitor, origin, rating, date and stay duration to be added.'))}</p></div></header><p>{t('暂无公开手记。','No published visitor notes yet.')}</p></article>}
  <div class="stay-review-footer"><p>{t.format('notePage',{count:reviews.total,pageSize:reviews.pageSize},reviews.total)}</p>
    {reviews.pages > 1 && <nav class="pagination" aria-label={t('手记分页','Visitor notes pages')}>
      {reviews.page > 1 && <a data-notes-prev href={pageHref(reviews.page-1)}>← {t('上一页','Previous')}</a>}
      <span aria-current="page">{reviews.page} / {reviews.pages}</span>
      {reviews.page < reviews.pages && <a data-notes-next href={pageHref(reviews.page+1)}>{t('下一页','Next')} →</a>}
    </nav>}
  </div>
</DetailSection></div>

<script>
 const me=await fetch('/api/auth/me');if(me.ok)for(const a of document.querySelectorAll<HTMLAnchorElement>('[data-provider-reply]')){try{const r=await fetch('/api/me/replies/'+a.dataset.providerReply);if(r.ok)a.hidden=false;}catch{}}
</script>
