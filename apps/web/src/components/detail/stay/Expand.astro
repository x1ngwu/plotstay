---
import { detailBilingual } from '../../../lib/detail-copy';
import type { Locale } from '@plotstay/contracts';
const { locale, label, id } = Astro.props as { locale: Locale; label?: string; id?: string };
const t = detailBilingual(locale.code, Astro.locals.detailCopy, 'common');
---
<details class="stay-expand" id={id}>
  <summary><span class="expand-label">{label ?? t('显示更多', 'Show more')}</span><span class="collapse-label">{t('收起', 'Show less')}</span><span class="expand-arrow" aria-hidden="true">↓</span></summary>
  <div class="stay-expanded"><slot /></div>
</details>
