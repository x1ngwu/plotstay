---
const { name = 'star' } = Astro.props as { name?: string };
import { iconPaths } from '../../../lib/icon-paths';

---
<svg class="stay-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d={iconPaths[name] ?? iconPaths.star}/></svg>
