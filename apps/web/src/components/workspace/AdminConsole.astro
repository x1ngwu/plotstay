---
import { bilingual } from '../../lib/i18n';
const { locale, mode = 'legacy' } = Astro.props;
const label = bilingual(locale.code);
---
<div id="admin" data-locale={locale.code} data-mode={mode}>
    <h1>{label('内容管理', 'Content management')}</h1><p><a href={`/${locale.pathPrefix}/account?view=moderation`}>{label('角色评价与回复审核／创建账号','Persona review moderation / create account')}</a> · <a id="new-workspace-link" href={`/${locale.pathPrefix}/workspace?view=works`}>{label('试用新版后台 ↗','Try the new workspace ↗')}</a></p>
    <p id="message" role="status" aria-live="polite"></p>
    <form id="login" class="panel">
      <label>{label('邮箱', 'Email')}<input name="email" type="email" autocomplete="username" required /></label>
      <label>{label('密码', 'Password')}<input name="password" type="password" autocomplete="current-password" required /></label>
      <button>{label('登录', 'Sign in')}</button>
    </form>
    <section id="workspace" hidden>
      <div class="admin-actions"><span id="account"></span><button id="logout">{label('退出登录', 'Sign out')}</button></div>
      <div class="ws-list-context"><label>{label('管理世界', 'World')}<select id="world"></select></label><div class="admin-actions"><button id="new">＋ {label('创建作品', 'Create work')}</button><button id="refresh-list">{label('刷新列表', 'Refresh list')}</button></div></div>
      <div class="ws-list-filters"><label>{label('名称或网址标识','Title or slug')}<input id="filter-query" type="search" placeholder={label('搜索作品名称','Search work title')} /></label><label>{label('筛选类型', 'Filter type')}<select id="filter-kind"><option value="">{label('全部类型', 'All types')}</option><option value="stay">{label('住宿', 'Homes')}</option><option value="experience">{label('活动', 'Experiences')}</option><option value="service">{label('服务', 'Services')}</option><option value="review">{label('手记', 'Notes')}</option></select></label><label>{label('发布状态','Publication status')}<select id="filter-status"><option value="">{label('全部状态','All statuses')}</option><option value="published">{label('已公开','Published')}</option><option value="unpublished">{label('未公开','Unpublished')}</option><option value="submitted">{label('待审核','Submitted')}</option><option value="draft">{label('草稿','Draft')}</option></select></label><button id="search-list">{label('筛选','Filter')}</button></div>
      <div class="ws-list-meta"><span id="ws-result-count"></span><div class="admin-actions"><button id="list-prev" aria-label={label('上一页','Previous page')}>←</button><span id="list-page"></span><button id="list-next" aria-label={label('下一页','Next page')}>→</button></div></div>
      {mode==='workspace' && <div id="work-cards" class="ws-work-grid"></div>}
      <div class="admin-table"><table><thead><tr><th>{label('内容', 'Content')}</th><th>{label('草稿状态', 'Draft status')}</th><th>{label('公开状态', 'Visibility')}</th><th>{label('操作', 'Action')}</th></tr></thead><tbody id="content-list"></tbody></table></div>
      <details class="panel" id="shared-settings-panel"><summary>{label('共用详情文案与关联资料','Detail copy and shared references')}</summary><section id="settings-panel"></section></details>
      <details class="panel" id="import-panel">
        <summary>{label('批量导入', 'Batch import')}</summary>
        <p>{label('先预览校验结果，再导入为草稿。相同来源与外部编号不会重复导入，已有内容不会被覆盖。', 'Preview validation before importing drafts. Source and external IDs prevent duplicate imports; existing content is preserved.')}</p>
        <button id="import-example">{label('填入示例', 'Use example')}</button>
        <label>{label('选择 JSON 文件', 'Choose JSON file')}<input id="import-file" type="file" accept="application/json,.json" /></label>
        <label>{label('导入内容（JSON）', 'Import data (JSON)')}<textarea id="import-json" rows="12"></textarea></label>
        <div class="admin-actions"><button id="import-preview">{label('预览校验', 'Validate preview')}</button><button id="import-apply" disabled>{label('导入草稿', 'Import drafts')}</button></div>
        <pre id="import-results"></pre><h3>{label('最近导入记录', 'Recent imports')}</h3><div id="import-history"></div>
      </details>
      <section id="editor-panel" class="panel" hidden>
        <h2 id="editor-title"></h2>
        <p id="revision-state"></p>
        {mode==='workspace' && <nav id="ws-section-nav" aria-label={label('编辑栏目','Editing sections')}><button type="button" data-section="basics">{label('名称与简介','Name and summary')}</button><button type="button" data-section="images">{label('图片','Images')}</button><button type="button" data-section="details">{label('详细介绍','Details')}</button><button type="button" data-section="price">{label('价格与规格','Price and specifications')}</button><button type="button" data-section="provider">{label('经营角色','Provider persona')}</button><button type="button" data-section="rules">{label('须知','Things to know')}</button></nav>}
        {mode==='workspace' && <div class="ws-editor-tabs admin-actions"><button id="ws-tab-edit" type="button">{label('编辑','Edit')}</button><button id="ws-tab-preview" type="button">{label('预览','Preview')}</button></div>}
        <section class="draft-preview-panel" aria-labelledby="draft-preview-title">
          <h3 id="draft-preview-title">{label('页面预览', 'Page preview')}</h3>
          <p id="draft-preview-state" role="status"></p>
          <div class="admin-actions draft-preview-actions">
            <button id="save-preview" type="button">{label('保存并预览', 'Save and preview')}</button>
            <label>{label('预览语言', 'Preview language')}<select id="draft-preview-language"><option value="zh">简体中文</option><option value="en">English</option></select></label>
            <label>{label('查看宽度', 'View width')}<select id="draft-preview-width"><option value="wide">{label('桌面', 'Desktop')}</option><option value="mobile">{label('手机', 'Mobile')}</option></select></label>
            <a id="draft-preview-full" target="_blank" rel="noopener" hidden>{label('打开完整页面 ↗', 'Open full page ↗')}</a>
          </div>
          <div id="draft-preview-area" hidden><iframe id="draft-preview-frame" title={label('草稿页面预览', 'Draft page preview')}></iframe></div>
        </section>
        <form id="editor">
          <fieldset id="identity"><legend>{label('归属与类型（创建后固定）', 'Identity (fixed after creation)')}</legend>
            <label>{label('类型', 'Type')}<select name="kind"><option value="stay">{label('住宿', 'Stay')}</option><option value="experience">{label('活动', 'Experience')}</option><option value="service">{label('服务', 'Service')}</option><option value="review">{label('游客手记', 'Visitor note')}</option></select></label>
            <label>{label('网址标识', 'URL slug')}<input name="slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="120" required /></label>
            <label>{label('地点', 'Place')}<select name="placeId"></select></label>
            <label>{label('手记所属内容', 'Parent entry for a note')}<select name="parentContentId"></select></label>
            <label>{label('虚构人物', 'Narrative persona')}<select name="personaId"></select></label>
          </fieldset>
          <label>{label('源语言', 'Source language')}<select name="sourceLocale"></select></label>
          <p>{label('修改源文后，请同时校订译文。也可清空译文并保存，让缺译语言进入任务队列；真实翻译服务暂未启用。', 'After changing the source, review its translations too. Clear translations and save to queue missing languages; the live translation service is not enabled yet.')}</p>
          <button id="clear-translations" type="button">{label('保留源文并清空译文', 'Keep source and clear translations')}</button>
          <fieldset><legend>{label('价格与分类', 'Price and category')}</legend>
            <label>{label('虚构金额（整数；手记留空）', 'Fictional amount (integer; blank for notes)')}<input name="amount" type="number" min="0" max="1000000000" step="1" /></label>
            <label>{label('活动／服务时长（分钟；服务可选）', 'Duration (minutes; optional for services)')}<input name="duration" type="number" min="1" max="43200" step="1" /></label>
            <label>{label('本篇评价评分（可选 1–5）', 'This review’s rating (optional, 1–5)')}<input name="rating" type="number" min="1" max="5" step="1" /></label>
            <p>{label('本篇评分只有发布后才参与条目均分；公开均分与评价数由已发布评价自动计算。人物卡片中的评分与评价数是另行填写的叙事数据。','This rating contributes to the entry average only after publication. Entry averages and counts come from published reviews. Host card ratings and counts are separately entered story data.')}</p>
          </fieldset>
          <label>{label('分类', 'Category')}<select name="category"></select></label>
          <button id="toggle-mode" type="button">{label('切换到高级 JSON','Switch to advanced JSON')}</button>
          <p id="list-alignment-warning" role="status"></p>
          <p>{label('文本列表按语言独立管理，图片以 ID 关联。删除项目会保存空列表；取消栏目配置恢复旧默认。','Text lists are independent per language. Images use stable IDs. Removing items saves an empty list; disabling a section restores legacy defaults.')}</p>
          <button id="refresh-image-fields" type="button">{label('刷新图片说明字段','Refresh image description fields')}</button>
          <div id="structured-editor"></div>
          <div id="advanced-fields" hidden>
          <label>{label('图片，每行填写：图片标识 | HTTPS 地址', 'Images, one per line: image ID | HTTPS URL')}<textarea name="images" rows="3"></textarea></label>
          <label>{label('服务样例日期（JSON，可留空）', 'Service sample dates (JSON, optional)')}<textarea name="serviceAttributes" rows="4"></textarea></label>
          <label>{label('活动场次与开放时间（JSON，可留空）', 'Experience sessions and opening time (JSON, optional)')}<textarea name="experienceAttributes" rows="4"></textarea></label>
          <label>{label('住宿规格与房东统计（JSON，可留空）', 'Stay specifications and host statistics (JSON, optional)')}<textarea name="stayAttributes" rows="4"></textarea></label>
          <label>{label('手记分项评分（JSON，可留空）', 'Visitor rating dimensions (JSON, optional)')}<textarea name="reviewRatings" rows="3"></textarea></label>
          <div id="language-fields"></div>
          </div>
          <button type="submit">{label('保存为新草稿', 'Save as new draft')}</button>
          <button id="export-draft" type="button">{label('下载当前草稿副本','Download current draft copy')}</button>
          <button id="reload-editor" type="button">{label('重新载入最新版本', 'Reload latest version')}</button>
        </form>
        <section id="workflow" hidden>
          <div class="admin-actions"><button id="entry-notes">{label('管理此条目的手记','Manage notes for this entry')}</button><button id="new-note">{label('新增后台手记','New editorial note')}</button><button id="preview-draft">{label('打开已保存草稿预览','Preview saved draft')}</button><span id="preview-links"></span></div>
          <h3>{label('审核与发布', 'Review and publication')}</h3>
          <p>{label('请检查源文与所有译文。以下操作针对已保存的版本；未保存的输入不会被发布。', 'Check the source and every translation. These actions apply to the saved version.')}</p>
          <pre id="content-changes"></pre>
          <label>{label('审核备注', 'Moderation note')}<textarea id="moderation-note" rows="2"></textarea></label>
          <div class="admin-actions">
            <button id="submit-revision">{label('提交审核', 'Submit for review')}</button>
            <button id="publish">{label('审核通过并发布', 'Approve and publish')}</button>
            <button id="reject">{label('退回修改', 'Request changes')}</button>
            <button id="unpublish">{label('下架', 'Unpublish')}</button>
            <button id="site-block">{label('网站强制下架', 'Site restriction')}</button>
            <button id="release-block">{label('解除网站限制', 'Lift site restriction')}</button>
          </div>
          <h3>{label('历史版本与发布', 'Revision and publication history')}</h3>
          <p>{label('载入历史版本可检查全文，保存时会创建新草稿。恢复发布只切换公开版本，保留当前草稿。', 'Load a revision to inspect its full text, then save it as a new draft. Restoring a publication preserves the current draft.')}</p>
          <div id="history"></div>
          <h3>{label('翻译任务', 'Translation tasks')}</h3><p id="translation-status"></p><div id="jobs"></div>
          <h3>{label('审核记录', 'Moderation history')}</h3><div id="events"></div>
        </section>
      </section>
    </section>
</div>
<script>import '../../lib/admin';</script>
<style is:global>
  #admin .bilingual-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  #admin .language-tabs { display:none; }
  #admin #structured-editor fieldset { padding:.6rem; }
  #admin .repeat-row > fieldset { border:0; margin:.25rem 0; padding:0; }
  #admin .repeat-row { padding:.5rem; border-bottom:1px solid var(--line); }
  #admin input[type=checkbox] { width:auto; }
  @media(max-width:700px) { #admin .bilingual-fields { grid-template-columns:1fr; } #admin .language-pane[data-active=false] { display:none; } #admin .language-tabs { display:flex; } }
  #admin [hidden] { display: none !important; }
  #admin label { display: grid; gap: .35rem; margin: .8rem 0; }
  #admin input, #admin select, #admin textarea, #admin button { font: inherit; color: var(--text); background: var(--surface); border: 1px solid var(--line); padding: .55rem; max-width: 100%; }
  #admin input, #admin textarea { width: 100%; }
  #admin button { cursor: pointer; border-color: var(--accent); }
  #admin button:disabled { cursor: default; opacity: .45; }
  #admin fieldset { border: 1px solid var(--line); margin: 1rem 0; min-width: 0; }
  #admin table { width: 100%; border-collapse: collapse; }
  #admin th, #admin td { padding: .65rem; border-bottom: 1px solid var(--line); text-align: left; }
  #admin .admin-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1rem 0; }
  #admin .admin-table { overflow: auto; }
  #admin pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  #admin #message { position: sticky; top: 0; background: var(--surface); padding: .7rem; z-index: 1; }
  #admin #message:empty { display: none; }
  #admin summary { cursor: pointer; }
  #admin .draft-preview-panel { border:1px solid var(--line); padding:1rem; margin:1rem 0 1.5rem; background:var(--surface); }
  #admin .draft-preview-panel h3 { margin:0; }
  #admin .draft-preview-panel p { margin:.55rem 0; }
  #admin .draft-preview-actions { align-items:end; }
  #admin .draft-preview-actions label { margin:0; min-width:8rem; }
  #admin .draft-preview-actions a { align-self:center; }
  #admin #draft-preview-area, #admin .draft-preview-area { width:100%; max-width:100%; margin:1rem auto 0; border:1px solid var(--line); overflow:hidden; }
  #admin #draft-preview-area[data-width=mobile], #admin .draft-preview-area[data-width=mobile] { max-width:390px; }
  #admin #draft-preview-frame, #admin .draft-preview-area iframe { display:block; width:100%; height:680px; border:0; background:var(--surface); }
  #admin .icon-selected { display:flex;align-items:center;gap:.3rem;margin:.2rem 0; }
  #admin .icon-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:.4rem;margin:.6rem 0; }
  #admin .icon-grid button { display:flex;align-items:center;gap:.4rem;text-align:left;min-height:3rem; }
  #admin .icon-grid button[aria-pressed=true] { outline:2px solid var(--accent);font-weight:700; }
</style>
