---
import { fontPreviews, getFontPreview } from '../lib/font-preview';
import { defaultFontStyle } from '../lib/typography';

const locale = Astro.url.searchParams.get('lang') === 'en' ? 'en' : 'zh';
const variant = getFontPreview(Astro.url.searchParams.get('font')) ?? defaultFontStyle(locale);
const mobile = Astro.url.searchParams.get('size') === 'mobile';
const current = fontPreviews.find(item => item.id === variant)!;
const pagePath = `/${locale}?font-preview=${variant}`;
Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');
---
<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <title>首页字体对照 · PlotStay</title>
  </head>
  <body>
    <header class="preview-toolbar">
      <div class="preview-heading"><a href="/zh">PLOTSTAY</a><h1>首页字体对照</h1><span>同一首页，只换字体</span></div>
      <div class="preview-controls">
        <nav aria-label="字体方案">{fontPreviews.map(item => <a href={`?font=${item.id}&lang=${locale}${mobile ? '&size=mobile' : ''}`} data-font={item.id} data-description={item.description} aria-current={item.id === variant ? 'true' : undefined}><strong>{item.label}</strong><span>{item.note}</span></a>)}</nav>
        <div class="preview-options">
          <label><span>语言</span><select id="preview-language"><option value="zh" selected={locale === 'zh'}>中文</option><option value="en" selected={locale === 'en'}>English</option></select></label>
          <label><span>视口</span><select id="preview-size"><option value="desktop" selected={!mobile}>桌面</option><option value="mobile" selected={mobile}>手机 · 390px</option></select></label>
          <a id="preview-open" href={pagePath} target="_blank" rel="noopener">单独打开 ↗</a>
          <button id="preview-reset" type="button">回到首页顶部 ↑</button>
        </div>
      </div>
      <p id="preview-description" aria-live="polite">{current.description}</p>
    </header>
    <div class:list={['preview-stage', { 'is-mobile': mobile }]}>
      <iframe id="preview-frame" src={pagePath} title={`PlotStay 首页 · ${current.label}`} data-variant={variant}></iframe>
    </div>
    <script>
      import { getFontPreview } from '../lib/font-preview';
      import { defaultFontStyle } from '../lib/typography';

      const frame = document.querySelector<HTMLIFrameElement>('#preview-frame')!;
      const language = document.querySelector<HTMLSelectElement>('#preview-language')!;
      const size = document.querySelector<HTMLSelectElement>('#preview-size')!;
      const open = document.querySelector<HTMLAnchorElement>('#preview-open')!;
      const description = document.querySelector<HTMLElement>('#preview-description')!;
      const choices = [...document.querySelectorAll<HTMLAnchorElement>('[data-font]')];
      let selected = getFontPreview(frame.dataset.variant ?? null) ?? 'terminal';

      const pagePath = () => `/${language.value}?font-preview=${selected}`;
      function updateControls() {
        const params = new URLSearchParams({ font: selected, lang: language.value });
        if (size.value === 'mobile') params.set('size', 'mobile');
        history.replaceState(null, '', `?${params}`);
        document.querySelector('.preview-stage')!.classList.toggle('is-mobile', size.value === 'mobile');
        open.href = pagePath();
        choices.forEach(choice => {
          const active = choice.dataset.font === selected;
          if (active) {
            choice.setAttribute('aria-current', 'true');
            description.textContent = choice.dataset.description!;
            frame.title = `PlotStay 首页 · ${choice.querySelector('strong')!.textContent}`;
          } else choice.removeAttribute('aria-current');
          const target = new URLSearchParams(params);
          target.set('font', choice.dataset.font!);
          choice.href = `?${target}`;
        });
      }
      function applyFont() {
        const doc = frame.contentDocument;
        // After following a listing link, return to the homepage for comparison.
        if (!doc?.querySelector('.hero-copy') || !doc.documentElement.hasAttribute('data-font-preview')) {
          frame.src = pagePath();
          return;
        }
        doc.documentElement.dataset.fontPreview = selected;
        doc.documentElement.dataset.fontStyle = selected;
        frame.contentWindow!.history.replaceState(null, '', pagePath());
      }
      choices.forEach(choice => choice.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        selected = getFontPreview(choice.dataset.font ?? null)!;
        updateControls();
        applyFont();
      }));
      language.addEventListener('change', () => {
        selected = defaultFontStyle(language.value);
        updateControls();
        frame.src = pagePath();
      });
      size.addEventListener('change', updateControls);
      frame.addEventListener('load', () => {
        // Only the homepage opts in; other pages retain their existing type.
        if (frame.contentDocument?.querySelector('.hero-copy') && frame.contentDocument.documentElement.hasAttribute('data-font-preview')) {
          const activeLocale = frame.contentDocument.documentElement.lang;
          language.value = activeLocale === 'en' ? 'en' : 'zh';
          updateControls();
          applyFont();
        }
      });
      document.querySelector('#preview-reset')!.addEventListener('click', () => {
        frame.src = pagePath();
      });
    </script>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; height: 100dvh; display: flex; flex-direction: column; background: #0b100e; color: #e5efe8; font: 14px/1.5 system-ui, sans-serif; }
  :global(a) { color: inherit; }
  .preview-toolbar { padding: 16px 24px 12px; border-bottom: 1px solid #34493c; background: #151e19; }
  .preview-heading { display: flex; gap: 16px; align-items: baseline; flex-wrap: wrap; }
  .preview-heading > a { color: #33ff99; font: 700 13px/1.5 monospace; letter-spacing: 2px; text-decoration: none; }
  h1 { font-size: 16px; margin: 0; font-weight: 600; }
  .preview-heading > span { color: #a6b6ac; font-size: 12px; }
  .preview-controls { display: flex; gap: 20px; justify-content: space-between; align-items: center; flex-wrap: wrap; margin-top: 12px; }
  nav { display: flex; gap: 6px; flex-wrap: wrap; }
  nav a { display: grid; gap: 2px; min-width: 118px; padding: 7px 12px; border: 1px solid #415347; border-radius: 5px; text-decoration: none; }
  nav strong { font-size: 13px; font-weight: 600; }
  nav span { font-size: 11px; color: #a6b6ac; }
  nav a[aria-current] { border-color: #33ff99; background: #1b3829; color: #a1ffcd; }
  nav a:hover { background: #223d2c; }
  .preview-options { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 12px; }
  label { display: flex; align-items: center; gap: 6px; color: #a6b6ac; }
  select, button { font: inherit; color: #e5efe8; background: #101812; border: 1px solid #415347; border-radius: 4px; padding: 7px; min-height: 36px; }
  button { cursor: pointer; }
  .preview-options a { text-underline-offset: 4px; }
  #preview-description { margin: 10px 0 0; color: #bccdc2; font-size: 12px; }
  .preview-stage { display: flex; justify-content: center; flex: 1; min-height: 0; background: #09100c; }
  iframe { display: block; width: 100%; height: 100%; border: 0; background: #111; }
  .is-mobile iframe { width: 390px; max-width: 100%; border-inline: 1px solid #34493c; }
  :is(a, button, select):focus-visible { outline: 2px solid #a1ffcd; outline-offset: 3px; }
  @media (max-width: 620px) {
    .preview-toolbar { padding: 12px; }
    .preview-heading { gap: 8px 12px; }
    .preview-heading > span { display: none; }
    .preview-controls { gap: 10px; }
    nav { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); width: 100%; }
    nav a { min-width: 0; padding: 7px 5px; }
    nav strong { font-size: 12px; }
    nav span { font-size: 10px; }
    .preview-options { gap: 8px; }
    label > span { display: none; }
    #preview-reset { display: none; }
  }
</style>
