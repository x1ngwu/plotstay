---
import Base from '../../layouts/Base.astro';
import { ApiFailure, getContents, getWorlds } from '../../lib/api';
import { messages } from '../../lib/i18n';
import { contentPath, homePath, fallbackLocales, type PublicContent, type World } from '@plotstay/contracts';
import { homeSeo, noIndex } from '../../lib/seo';
const { locales, locale: selectedLocale, localeFailure } = Astro.locals;
const locale = selectedLocale ?? fallbackLocales[0]!;
const ui = messages(locale.code);
let worlds: World[] = [], world: World | undefined, contents: PublicContent[] = [];
let failed = false;
try {
  if (localeFailure) throw new ApiFailure(503);
  if (!selectedLocale) throw new ApiFailure(404);
  ({ worlds } = await getWorlds(locale.code));
  const selected = Astro.url.searchParams.get('world') ?? 'lathe-worlds';
  world = worlds.find(item => item.slug === selected);
  if (!world) throw new ApiFailure(404);
  const type = Astro.url.searchParams.get('type') ?? 'all';
  if (!['all', 'stays', 'experiences'].includes(type)) throw new ApiFailure(404);
  const filters: Record<string, string> = { world: world.slug };
  if (type !== 'all') filters.kind = type === 'stays' ? 'stay' : 'experience';
  const q = Astro.url.searchParams.get('q')?.trim();
  if (q) filters.q = q;
  ({ contents } = await getContents(locale.code, filters));
} catch (error) {
  failed = true;
  Astro.response.status = error instanceof ApiFailure && [400, 404].includes(error.status) ? 404 : 503;
}
---
<Base title={world?.name ?? 'Plotstay'} description={world?.description} locale={locale} locales={locales} theme={world?.themeId} seo={failed ? noIndex() : homeSeo(Astro.url, locale, locales, world!)}>
  {failed ? <h1>{Astro.response.status === 404 ? ui.notFound : ui.unavailable}</h1> : <>
    <p class="eyebrow">{ui.sample}</p>
    <h1 lang={world!.languageTag}>{world!.name}</h1>
    <p lang={world!.languageTag}>{world!.description}</p>
    {world!.locale !== locale.code && <p class="notice">{ui.fallback}</p>}
    <nav class="worlds" aria-label="World">
      {worlds.map(item => <a href={homePath(locale, item.slug)} lang={item.languageTag} aria-current={world?.id === item.id ? 'page' : undefined}>{item.name}</a>)}
    </nav>
    <ul class="entries">
      {contents.map(content => <li class="panel" data-content-id={content.id}>
        <span class="eyebrow">{content.kind === 'stay' ? ui.stays : ui.experiences}</span>
        <h2 lang={content.languageTag}><a href={contentPath(locale, content)}>{content.text.title}</a></h2>
        <p>{content.placeName}</p>
        <p lang={content.languageTag}>{content.text.summary}</p>
        {content.isFallback && <p class="notice">{ui.fallback}</p>}
        {content.attributes.price && <p>{new Intl.NumberFormat(locale.languageTag).format(content.attributes.price.amount)} {world!.currencyName} / {ui[content.attributes.price.unit]}</p>}
      </li>)}
    </ul>
    {contents.length === 0 && <p>{ui.empty}</p>}
  </>}
</Base>
