---
import Base from '../../../layouts/Base.astro';
import Summary from '../../../components/booking/Summary.astro';
import { api, getWorlds, ApiFailure } from '../../../lib/api';
import { fallbackLocales, idSchema, contentPath, publishedSessions, type PublicContent, type World } from '@plotstay/contracts';
import { travelBilingual, copyText } from '../../../lib/travel-copy';
import '../../../styles/booking.css';
const {locales,locale:selected,localeFailure}=Astro.locals;
const locale=selected??fallbackLocales[0]!;
let content:PublicContent|undefined,world:World|undefined;
try{
 if(localeFailure)throw new ApiFailure(503);
 if(!selected||!idSchema.safeParse(Astro.params.id).success)throw new ApiFailure(404);
 content=(await api<{content:PublicContent}>(`/api/contents/${Astro.params.id}`,{locale:locale.code})).content;
 if(content.kind==='review')throw new ApiFailure(404);
 world=(await getWorlds(locale.code)).worlds.find(w=>w.id===content!.worldId);
}catch(e){Astro.response.status=e instanceof ApiFailure&&e.status===404?404:503;}
const t=travelBilingual(locale.code,world?.slug);
const sessions=content?publishedSessions(content):[];
const date=new Intl.DateTimeFormat(locale.languageTag,{dateStyle:'medium',timeStyle:'short',timeZone:'UTC',hour12:false});
const backQuery=new URLSearchParams();
for(const key of ['start','end','guests','rooms','quantity','time']){const value=Astro.url.searchParams.get(key);if(value)backQuery.set(key,value);}
backQuery.set('from','results');backQuery.set('view','results');backQuery.set('type',content?.kind==='stay'?'stays':content?.kind==='service'?'services':'experiences');
if(content?.kind!=='stay'){backQuery.delete('rooms');backQuery.delete('end');}
if(content?.kind!=='service'){backQuery.delete('quantity');backQuery.delete('time');}
---
<Base title={t('模拟预订','Fictional booking')} locale={locale} locales={locales} world={world}>
 {content?<div class="booking-page" data-booking-page data-world={world?.slug} data-content-id={content.id} data-kind={content.kind} data-locale={locale.code} data-prefix={locale.pathPrefix} data-fixed={sessions.length>0?'true':'false'}>
  <a class="booking-back" href={contentPath(locale,content)+'?'+backQuery}>← {t('返回详情','Back to listing')}</a>
  <header class="booking-heading"><p class="eyebrow">{t('旅行登记处','JOURNEY DESK')}</p><h1>{t('把下一站写进故事','Put your next stop in the story')}</h1><p>{t('选择行程，核对虚构价格，领取属于你的旅行凭条。','Choose your trip, review the fictional price and collect your travel document.')}</p></header>
  <ol class="booking-steps"><li>1 {copyText('booking.steps.choose',locale.code)}</li><li>2 {copyText('booking.steps.review',locale.code)}</li><li>3 {copyText('booking.steps.collect',locale.code)}</li></ol>
  <div class="booking-grid">
   <section class="panel booking-editor">
    <div class="window-bar"><span>{t('行程资料','Trip details')}</span><span>01</span></div>
    <div class="booking-editor-body">
     <h2 lang={content.languageTag}>{content.text.title}</h2><p>{world?.name} · {content.placeName}</p>
     {content.attributes.images[0]&&<img class="booking-cover" src={content.attributes.images[0].url} alt={content.text.imageAlts[content.attributes.images[0].id]||''} width="600" height="240"/>}
     <form data-trip-form>
      <fieldset data-trip-fields disabled>
       {content.kind==='stay'?<div class="booking-fields"><label>{t('入住日期','Check-in')}<input name="start" type="date" required/></label><label>{t('退房日期','Checkout')}<input name="end" type="date" required/></label></div>:sessions.length?<label>{t('场次 · UTC','Session · UTC')}<select name="startsAt" required><option value="">{t('请选择场次','Choose a session')}</option>{sessions.map(s=><option value={s.startsAt} disabled={Date.parse(s.startsAt)<=Date.now()}>{date.format(new Date(s.startsAt))} – {date.format(new Date(s.endsAt))} UTC{Date.parse(s.startsAt)<=Date.now()?t('（已过期）',' (expired)'):''}</option>)}</select></label>:<div class="booking-fields"><label>{t('日期 · UTC','Date · UTC')}<input name="start" type="date" required/></label><label>{t('模拟场次 · UTC','Simulation session · UTC')}<select name="time" required><option value="">{t('请选择时间','Choose a time')}</option><option value="10:00">10:00 UTC</option><option value="14:00">14:00 UTC</option></select></label></div>}
       <div class="booking-fields"><label>{t('人数','Travellers')}<input name="guests" type="number" min="1" max="99" step="1" value="1" required/></label>
        {content.kind==='stay'?<label>{t('房间数','Rooms')}<input name="rooms" type="number" min="1" max="20" step="1" value="1" required/></label>:content.kind==='service'&&<label>{t('服务数量','Service quantity')}<input name="quantity" type="number" min="1" max="99" step="1" value="1" required/></label>}
       </div>
       <p class="booking-fine">{content.kind==='stay'?t('每间每晚计价 · 1–30 晚 · 日期按 UTC 自然日计算。','Per room, per night · 1–30 nights · UTC calendar dates.'):content.kind==='experience'?t('每人每场计价 · 所有场次以 UTC 为准。','Per person, per session · all times UTC.'):t('每次服务计价 · 数量不延长场次时长，人数不额外计费 · UTC。','Per service · quantity does not extend the session; travellers do not add a charge · UTC.')}</p>
       <p class="booking-fine">{t('无库存保证；这些是虚构行程。可选择未来 365 天内开始的行程。','No inventory guarantee; these trips are fictional. Start within the next 365 days.')}</p>
      </fieldset>
      <p class="booking-notice" data-preference-note hidden></p>
      <button class="booking-primary" type="submit" data-quote disabled>{t('核对行程与价格','Review trip & price')}</button>
     </form>
     <section class="booking-platform-notice"><h3>{copyText('platform.notices.heading',locale.code)}</h3><p>{copyText('platform.notices.booking',locale.code)}</p></section>
     <p class="booking-fine">{t('不需要银行卡、真实姓名或联系方式。游客凭证只保存在此浏览器中，有效期 180 天。','No bank card, real name or contact details. Your visitor credential stays in this browser for 180 days.')}</p>
     <noscript><p>{t('请启用 JavaScript 以核对并保存模拟预订。','Enable JavaScript to review and save a fictional booking.')}</p></noscript>
    </div>
   </section>
   <section class="booking-review" data-review hidden aria-label={t('确认预订','Review booking')}>
    <header class="booking-heading"><p class="eyebrow">{world?.slug==='lathe-worlds' ? copyText('booking.review.eyebrow',locale.code) : t('核对','Review')}</p><h2>{world?.slug==='lathe-worlds' ? copyText('booking.review.title',locale.code) : t('核对行程','Review itinerary')}</h2><p>{copyText('booking.review.intro',locale.code)}</p></header><Summary locale={locale}/>
    <div class="booking-confirm panel">
     <label class="booking-consent"><input type="checkbox" data-consent/>{t('我知道这是虚构旅行，不会真实扣款。','I understand this is a fictional trip with no real charge.')}</label>
     <button class="booking-primary" data-confirm disabled>{t('确认并签发凭条','Confirm & issue document')}</button>
     <button class="booking-secondary" data-edit>{t('修改行程','Edit trip')}</button>
    </div>
   </section>
  </div>
  <p class="booking-notice" role="status" aria-live="polite" data-booking-message></p>
  <button class="booking-secondary" data-retry hidden>{t('重试同一次预订','Retry this booking')}</button>
 </div>:<section class="panel booking-empty"><h1>{Astro.response.status===404?t('暂时无法预订此内容','This listing is not available'):t('预订服务暂时不可用','Booking is temporarily unavailable')}</h1><p>{t('内容可能已经下架，或服务暂时中断。请返回浏览或稍后刷新。','The listing may have been withdrawn, or the service is temporarily unavailable. Browse other listings or reload later.')}</p><a href={`/${locale.pathPrefix}`}>{t('继续浏览','Continue exploring')}</a></section>}
 <script>import {initBooking} from '../../../lib/booking-client';void initBooking();</script>
</Base>
