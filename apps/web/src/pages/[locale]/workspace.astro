---
import '../../styles/workspace-overview.css';
import WorkspaceLayout from '../../layouts/WorkspaceLayout.astro';
import AdminConsole from '../../components/workspace/AdminConsole.astro';
import { fallbackLocales } from '@plotstay/contracts';
import { bilingual, messages } from '../../lib/i18n';
const { locales, locale: selectedLocale, localeFailure } = Astro.locals;
const locale = selectedLocale ?? fallbackLocales[0]!;
const t = bilingual(locale.code);
const failed = localeFailure || !selectedLocale;
if (failed) Astro.response.status = localeFailure ? 503 : 404;
Astro.response.headers.set('Cache-Control','private, no-store');
const view = Astro.url.searchParams.get('view') ?? 'overview';
const adminViews = ['works','editor','world-content','world-settings','world-tools','world-review'];
const accountViews = ['personas','reviews','replies','moderation','site'];
const title = ({overview:t('今天，从这里继续','Today, pick up where you left off'),works:t('我管理的内容','Content I manage'),editor:t('内容编辑','Edit content'),personas:t('我的角色','My personas'),reviews:t('评价与回复','Reviews and replies'),replies:t('评价与回复','Reviews and replies'),worlds:t('我管理的世界','Worlds I manage'),'world-content':t('世界内容','World content'),'world-settings':t('世界设定','World settings'),'world-tools':t('管理工具','Management tools'),'world-review':t('世界审核','World moderation'),'shared-settings':t('共享资料','Shared settings'),'world-members':t('成员','Members'),moderation:t('世界审核','World moderation'),site:t('网站审核','Site moderation'),settings:t('账号设置','Account settings')} as Record<string,string>)[view] ?? t('概览','Overview');
const worldId = Astro.url.searchParams.get('world');
const oldAccountView = view==='site'?'moderation':view==='settings'?'personas':view;
const oldQuery=new URLSearchParams();
for(const key of ['world','content','kind','q','status','page'])if(Astro.url.searchParams.has(key))oldQuery.set(key,Astro.url.searchParams.get(key)!);
const legacyTarget=accountViews.includes(view)||view==='settings'?`/${locale.pathPrefix}/account?view=${oldAccountView}`:`/${locale.pathPrefix}/admin${oldQuery.size?'?'+oldQuery:''}`;
---
<WorkspaceLayout title={title} locale={locale}>
{failed ? <h1>{localeFailure ? messages(locale.code).unavailable : messages(locale.code).notFound}</h1> :
<div id="new-workspace" data-locale={locale.code} data-prefix={locale.pathPrefix} data-view={view}>
  <div class="ws-utility"><strong>{t('Plotstay · 私人工作台','Plotstay · Private workspace')}</strong><span>{t('创作与管理','Create and manage')}</span><nav aria-label={t('语言','Language')}>{locales.map(item => <a href={`/${item.pathPrefix}/workspace${Astro.url.search}`} lang={item.languageTag} aria-current={item.code===locale.code?'page':undefined}>{item.code==='zh-CN'?'中文':'English'}</a>)}</nav></div>
  <div class="ws-shell">
  <aside class="ws-sidebar">
    <a class="ws-brand" href={`/${locale.pathPrefix}/workspace`}><span class="ws-brand-icon" aria-hidden="true">P</span><span>PLOTSTAY</span></a>
    <p class="ws-nav-label">{t('我的工作台','My workspace')}</p>
    <nav class="ws-nav" aria-label={t('工作台导航','Workspace navigation')}>
      <a href={`/${locale.pathPrefix}/workspace`}><span aria-hidden="true">◫</span>{t('概览','Overview')}</a>
      <a href={`/${locale.pathPrefix}/workspace?view=personas`}><span aria-hidden="true">◉</span>{t('我的角色','My personas')}</a>
      <a href={`/${locale.pathPrefix}/workspace?view=works`}><span aria-hidden="true">▧</span>{t('我管理的内容','Content I manage')}</a>
      <a href={`/${locale.pathPrefix}/workspace?view=reviews`}><span aria-hidden="true">☷</span>{t('评价与回复','Reviews and replies')}</a>
      <a href={`/${locale.pathPrefix}/workspace?view=worlds`}><span aria-hidden="true">◎</span>{t('我管理的世界','Worlds I manage')}</a>
      <a href={`/${locale.pathPrefix}/workspace?view=settings`}><span aria-hidden="true">⚙</span>{t('账号设置','Account settings')}</a>
      <a class="ws-site-link" hidden href={`/${locale.pathPrefix}/workspace?view=site`}><span aria-hidden="true">◇</span>{t('网站审核','Site moderation')}</a>
    </nav>
    <div class="ws-sidebar-footer"><div class="ws-account-mark" aria-hidden="true">P</div><div><strong id="ws-account-name">{t('私人工作台','Private workspace')}</strong><small>{t('使用现有账号','Existing account')}</small></div><a class="ws-legacy" href={legacyTarget}>{t('旧版 ↗','Previous ↗')}</a></div>
  </aside>
  <main id="main" class="ws-main">
    <div class="ws-page-navigation"><a id="ws-back" href={`/${locale.pathPrefix}/workspace`}>← {t('返回工作台','Back to workspace')}</a><nav class="ws-crumbs" aria-label={t('面包屑','Breadcrumb')}><a href={`/${locale.pathPrefix}/workspace`}>{t('我的工作台','My workspace')}</a><span id="ws-crumb-tail"></span></nav></div>
    <div class="ws-page-head"><div><p class="ws-eyebrow">{t('我的工作台','My workspace')}</p><h1 id="ws-page-title">{title}</h1><p id="ws-context">{view==='overview'?t('查看需要处理的事，或接着完成上次的创作。','See what needs attention, or continue your last project.'):view==='works'?t('按所选世界的现有管理权限显示住宿、活动、服务和手记。','Homes, experiences, services and notes in the selected world, within your current management access.'):''}</p></div><a hidden id="ws-head-action" href={`/${locale.pathPrefix}/workspace?view=works`}>{t('打开我管理的内容 →','Open managed content →')}</a></div>
    {worldId && view.startsWith('world-') && <nav class="ws-world-nav" aria-label={t('世界管理','World management')}><a href={`/${locale.pathPrefix}/workspace?view=world-content&world=${worldId}`}>{t('内容','Content')}</a><a href={`/${locale.pathPrefix}/workspace?view=world-review&world=${worldId}`}>{t('审核','Moderation')}</a><a href={`/${locale.pathPrefix}/workspace?view=world-settings&world=${worldId}`}>{t('设定与共享资料','Settings')}</a><a href={`/${locale.pathPrefix}/workspace?view=world-tools&world=${worldId}`}>{t('管理工具','Tools')}</a><a href={`/${locale.pathPrefix}/workspace?view=world-members&world=${worldId}`}>{t('成员','Members')}</a></nav>}
    <p id="ws-message" role="status" aria-live="polite"></p>
    <form id="ws-login" class="ws-panel" hidden><h2>{t('登录现有账号','Sign in to your account')}</h2><label>{t('邮箱','Email')}<input name="email" type="email" autocomplete="username" required /></label><label>{t('密码','Password')}<input name="password" type="password" autocomplete="current-password" required /></label><button>{t('登录后继续','Sign in and continue')}</button></form>
    <section id="ws-overview" hidden><p class="ws-loading" role="status">{t('正在载入工作台…','Loading workspace…')}</p></section>
    {view==='shared-settings' && <section id="ws-shared-settings" class="ws-panel"></section>}
    <section id="ws-worlds" hidden><div id="ws-world-list"></div></section>
    <section id="ws-members" hidden><div id="ws-member-list"></div></section>
    <section id="ws-settings" hidden><div id="ws-account"></div></section>
    {adminViews.includes(view) && <AdminConsole locale={locale} mode="workspace" />}
    {accountViews.includes(view) && <div id="persona-workspace" data-locale={locale.code} data-prefix={locale.pathPrefix}>
      <p id="persona-message" role="status" aria-live="polite"></p>
      <form id="account-login" class="panel" hidden><h2>{t('登录现有账号','Sign in to your account')}</h2><label>{t('邮箱','Email')}<input name="email" type="email" autocomplete="username" required/></label><label>{t('密码','Password')}<input name="password" type="password" autocomplete="current-password" required/></label><button>{t('登录','Sign in')}</button></form>
      <div id="account-content" hidden><nav class="account-tabs"><a href={`/${locale.pathPrefix}/workspace?view=personas`}>{t('我的角色','My personas')}</a><a href={`/${locale.pathPrefix}/workspace?view=reviews`}>{t('我的评价','My reviews')}</a><a href={`/${locale.pathPrefix}/workspace?view=replies`}>{t('提供者回复','Provider replies')}</a><a data-review-admin hidden href={`/${locale.pathPrefix}/workspace?view=moderation`}>{t('评价与回复审核','Review moderation')}</a></nav><section id="account-view"></section></div>
    </div>}
  </main></div>
</div>}
</WorkspaceLayout>
<script>import '../../lib/workspace';if(document.querySelector('#persona-workspace'))void import('../../lib/persona-client').then(({initAccount})=>initAccount());</script>
