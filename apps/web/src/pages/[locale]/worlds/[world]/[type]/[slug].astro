---
import Base from '../../../../../layouts/Base.astro';
import { ApiFailure, getContent, getContents, getWorlds } from '../../../../../lib/api';
import { messages, uiLocale } from '../../../../../lib/i18n';
import { homePath, fallbackLocales, type PublicContent, type World } from '@plotstay/contracts';
import { contentDescription, detailSeo, noIndex } from '../../../../../lib/seo';
const { world: worldSlug = '', type = '', slug = '' } = Astro.params;
const { locales, locale: selectedLocale, localeFailure } = Astro.locals;
const locale = selectedLocale ?? fallbackLocales[0]!;
const ui = messages(locale.code);
const interfaceTag = [...locales, ...fallbackLocales].find(item => item.code === uiLocale(locale.code))!.languageTag;
let world: World | undefined, content: PublicContent | undefined, reviews: PublicContent[] = [];
let failed = false;
try {
  if (localeFailure) throw new ApiFailure(503);
  if (!selectedLocale || !['stays', 'experiences'].includes(type)) throw new ApiFailure(404);
  world = (await getWorlds(locale.code)).worlds.find(item => item.slug === worldSlug);
  if (!world) throw new ApiFailure(404);
  ({ content } = await getContent(locale.code, worldSlug, type === 'stays' ? 'stay' : 'experience', slug));
  ({ contents: reviews } = await getContents(locale.code, { world: worldSlug, parentId: content.id }));
} catch (error) {
  failed = true;
  Astro.response.status = error instanceof ApiFailure && [400, 404].includes(error.status) ? 404 : 503;
}
---
<Base title={content?.text.title ?? 'Plotstay'} description={content ? contentDescription(content.text) : undefined} locale={locale} locales={locales} theme={world?.themeId} seo={failed ? noIndex() : detailSeo(locale, locales, world!, content!)}>
  {failed ? <h1>{Astro.response.status === 404 ? ui.notFound : ui.unavailable}</h1> : <>
    <a href={homePath(locale, worldSlug)}>← {ui.home} · {world!.name}</a>
    <article class="panel" data-content-id={content!.id} data-publication-id={content!.publicationId}>
      <p class="eyebrow">{ui.sample}</p>
      {content!.isFallback && <p class="notice">{ui.fallback}</p>}
      <div lang={content!.languageTag}>
        <h1>{content!.text.title}</h1>
        <p>{content!.placeName}</p>
        <p class="prose">{content!.text.description}</p>
        {(['facilities', 'itinerary', 'rules'] as const).map(key => content!.text[key].length > 0 && <section>
          <h2 lang={interfaceTag}>{ui[key]}</h2><ul>{content!.text[key].map(line => <li>{line}</li>)}</ul>
        </section>)}
        {content!.text.hostName && <section><h2>{content!.text.hostName}</h2><p>{content!.text.hostBio}</p></section>}
      </div>
      {content!.attributes.price && <p>{new Intl.NumberFormat(locale.languageTag).format(content!.attributes.price.amount)} {world!.currencyName} / {ui[content!.attributes.price.unit]}</p>}
      {content!.attributes.durationMinutes && <p>{content!.attributes.durationMinutes} {ui.minutes}</p>}
    </article>
    {reviews.length > 0 && <section><h2>{ui.notes}</h2>{reviews.map(review => <article class="panel" lang={review.languageTag}>
      <h3>{review.text.title}</h3><p>{review.personaName}</p><p>{review.text.description}</p>
      {review.isFallback && <p lang={interfaceTag} class="notice">{ui.fallback}</p>}
    </article>)}</section>}
  </>}
</Base>
