---
import Base from '../../../../../layouts/Base.astro';
import DetailBody from '../../../../../components/DetailBody.astro';
import {getLocales,getWorlds} from '../../../../../lib/api';
import {fallbackLocales,resolveLocale,parseBrowse,type ContentDetail} from '@plotstay/contracts';
import {noIndex} from '../../../../../lib/seo';
import '../../../../../styles/detail.css';
import '../../../../../styles/stay.css';
import '../../../../../styles/service.css';
import '../../../../../styles/experience.css';
let detail:ContentDetail|undefined,world;
const locales=(await getLocales()).locales;
const locale=resolveLocale(Astro.params.locale??'',locales)??fallbackLocales[0]!;
try{
 const url=new URL(`/api/admin/contents/${encodeURIComponent(Astro.params.id??'')}/preview`,process.env.API_INTERNAL_URL??'http://127.0.0.1:4310');
 for(const key of ['revisionId','token'])url.searchParams.set(key,Astro.url.searchParams.get(key)??'');url.searchParams.set('locale',locale.code);for(const key of ['settingId','settingRevision','homeRevision'])if(Astro.url.searchParams.has(key))url.searchParams.set(key,Astro.url.searchParams.get(key)!);
 const response=await fetch(url,{headers:{cookie:Astro.request.headers.get('cookie')??''},cache:'no-store'});
 Astro.response.status=response.status;
 if(response.ok){detail=await response.json();world=(await getWorlds(locale.code)).worlds.find(w=>w.id===detail!.content.worldId);}
}catch{Astro.response.status=503;}
if(detail?.previewSetting?.kind==='copy')Astro.locals.detailCopy=detail.previewSetting.body;
if(detail?.previewSetting?.kind==='world'&&world){const text=detail.previewSetting.body[locale.code]??detail.previewSetting.body[world.sourceLocale];if(text)world={...world,...text};}
Astro.response.headers.set('Cache-Control','private, no-store');Astro.response.headers.set('X-Robots-Tag','noindex, nofollow, noarchive');
const state=parseBrowse(new URLSearchParams());
---
<Base title="Draft preview" locale={locale} locales={locales} world={world} seo={noIndex()}>
 <p class="notice" data-preview-banner>草稿预览 / Draft preview · {Astro.url.searchParams.get('revisionId')} · {locale.name} · {detail?.previewSetting ? `配置预览 / Configuration: ${detail.previewSetting.revisionId}` : ''} · 不可预订 / Booking disabled</p>
 {!detail||!world?<h1>预览不可用：请登录后台并重新打开当前已保存版本。 / Sign in and reopen the saved version.</h1>:detail.content.kind==='review'?<article data-review-preview><h1>{detail.content.text.title}</h1><p>{detail.content.text.review?.name}</p><p>{detail.content.text.review?.origin} · {detail.content.text.review?.stayDuration}</p><p>{detail.content.attributes.rating} ★</p><dl>{Object.entries(detail.content.attributes.reviewRatings??{}).map(([key,value])=><div><dt>{key}</dt><dd>{value}</dd></div>)}</dl><ul>{detail.content.text.tags.map(tag=><li>{tag}</li>)}</ul><p>{detail.content.text.description}</p><p>此草稿不计入公开评分 / This draft does not count towards public ratings.</p></article>:<div class:list={['detail-page',`${detail.content.kind}-detail`]}><DetailBody detail={detail} locale={locale} world={world} state={state}/></div>}
</Base>
