---
import '../styles/account.css';
import '../styles/workspace.css';
const { title, locale } = Astro.props;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
---
<!doctype html>
<html lang={locale.languageTag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title} · Plotstay</title>
  </head>
  <body>
    <a class="ws-skip" href="#main">{locale.code === 'zh-CN' ? '跳到内容' : 'Skip to content'}</a>
    <slot />
  </body>
</html>
