---
import '@plotstay/themes/layout.css';
import '@plotstay/themes/lime.css';
import { fallbackLocales, homePath, type Locale } from '@plotstay/contracts';
import { hasDictionary, languagePath, messages, uiLocale } from '../lib/i18n';
import { noIndex, type Seo } from '../lib/seo';
interface Props { title: string; description?: string; locale?: Locale; locales?: Locale[]; theme?: string; seo?: Seo }
const { title, description = '', locale = fallbackLocales[0]!, locales = [], theme = 'lime', seo = noIndex() } = Astro.props;
const ui = messages(locale.code);
const interfaceTag = [...locales, ...fallbackLocales].find(item => item.code === uiLocale(locale.code))!.languageTag;
if (!seo.canonical) Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');
---
<!doctype html>
<html lang={interfaceTag} data-theme={theme === 'lime' ? theme : 'lime'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Plotstay</title>
    <meta name="description" content={description} />
    {!seo.canonical && <meta name="robots" content="noindex, follow" />}
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    {seo.alternates.map(item => <link rel="alternate" hreflang={item.tag} href={item.url} />)}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={homePath(locale)}>PLOTSTAY</a>
      <nav aria-label="Language">
        {locales.map(item => <a href={languagePath(Astro.url, item)} lang={item.languageTag} aria-current={locale.code === item.code ? 'page' : undefined}>{item.name}</a>)}
      </nav>
    </header>
    <main>{!hasDictionary(locale.code) && <p class="notice">{ui.uiFallback}</p>}<slot /></main>
    <footer>{ui.about}</footer>
  </body>
</html>
